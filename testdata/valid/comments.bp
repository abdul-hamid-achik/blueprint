blueprint "test-comments" {
  version  "0.1.0"
  port     3000
  runtime  node
}

# Top-level comment
secret API_KEY required  # inline comment

# Another comment
# Multiple lines of comments
env LOG_LEVEL "info"

# Comment before endpoint
GET /api/health {
  # Comment inside block
  -> 200 { status: "ok" }  # trailing comment
}
