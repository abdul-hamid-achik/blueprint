blueprint "test-guards" {
  version  "0.1.0"
  port     3000
  runtime  node
  database postgres
}

model item {
  id      uuid   primary
  user_id uuid   required
  name    string required
}

GET /api/items/:id {
  <- id              uuid required
  <- current_user_id uuid required

  |> item = fetch item(id)
  |> guard item                            -> 404 "Item not found"
  |> guard item.user_id == current_user_id -> 403 "Not your item"

  -> 200 {
    id:   item.id,
    name: item.name,
  }
}
