@ "Real-time chat service with rooms, WebSocket, and SSE"
blueprint "realtime-chat" {
  version  "1.0.0"
  port     3000
  runtime  node
  database postgres
  cache    redis
}

secret DATABASE_URL required

secret JWT_SECRET required

model room {
  id          uuid      primary
  name        string    unique required
  description string    optional
  created     timestamp default(now)
}

model message {
  id      uuid      primary
  room_id uuid      ref(room) required
  sender  string    required
  body    string    required
  created timestamp default(now)
}

fn verify_jwt {
  <- token  string

  -> json

  impl node { module: "./internal/auth", func: "verifyJwt" }
}

@ "Create a new chat room"
POST /api/rooms {
  <- name         string  required  min(1)  max(50)
  <- description  string  optional  max(200)
  |> existing = query room where(name == name) first
  |> guard not existing -> 409 "Room name already taken"
  |> room = save room { name: name, description: description }
  -> 201 { id: room.id, name: room.name, description: room.description }
}

@ "List all rooms"
GET /api/rooms {
  |> rooms = query room order(name, asc)
  -> 200 { rooms: rooms }
}

@ "Get a room by ID"
GET /api/rooms/:id {
  <- id  uuid  required
  |> room = fetch room(id)
  |> guard room -> 404 "Room not found"
  -> 200 {
    id: room.id,
    name: room.name,
    description: room.description,
    created: room.created,
  }
}

@ "Delete a room"
DELETE /api/rooms/:id {
  <- id  uuid  required
  |> room = fetch room(id)
  |> guard room -> 404 "Room not found"
  |> msgs = query message where(room_id == id)
  |> delete msgs
  |> delete room
  -> 204 "deleted"
}

@ "Get message history for a room"
GET /api/rooms/:id/messages {
  <- id        uuid  required
  <- page      int   default(1)  min(1)
  <- per_page  int   default(50)  min(1)  max(200)
  |> room = fetch room(id)
  |> guard room -> 404 "Room not found"
  |> messages = query message where(room_id == id) order(created, desc) paginate(page, per_page)
  -> 200 { messages: messages.items, total: messages.total, page: page }
}

@ "Join a room and chat in real time"
WS /ws/rooms/:id {
  auth bearer
  on_connect {
    |> room = fetch room(id)
    |> guard room -> 404 "Room not found"
    |> payload = verify_jwt(header.Authorization)
    |> guard payload -> 401 "Authentication required"
    |> inject payload.username as sender
    |> join room(id)
    |> log "User {sender} joined room {room.name}" level(info)
    |> broadcast room(id) { type: "joined", sender: sender }
    -> { type: "connected", room: room.name, sender: sender }
  }
  on_message {
    |> guard message.body -> 400 "Empty message"
    |> guard message.body.length < 2000 -> 400 "Message too long (max 2000 chars)"
    |> when message.type == "message" {
      |> save message { room_id: id, sender: sender, body: message.body }
      |> emit new_message { room_id: id, sender: sender, body: message.body }
      |> broadcast room(id) {
        type: "message",
        sender: sender,
        body: message.body,
        created: now,
      }
    }
  }
  on_disconnect {
    |> leave room(id)
    |> log "User {sender} left room {room.name}" level(info)
    |> broadcast room(id) { type: "left", sender: sender }
  }
}

@ "Stream new messages in a room via Server-Sent Events"
STREAM /api/rooms/:id/live {
  tags  ["rooms", "streaming"]

  <- id  uuid  required
  |> room = fetch room(id)
  |> guard room -> 404 "Room not found"

  stream {
    |> on event(new_message) where(room_id == id) {
      -> { sender: event.sender, body: event.body, created: event.created }
    }
    |> on event(room_event) where(room_id == id) {
      -> { type: event.type, sender: event.sender }
    }
    |> on timeout(5min) {
      -> { type: "ping" }
    }
  }
}

@ "Stream online user count for a room"
STREAM /api/rooms/:id/presence {
  <- id  uuid  required
  |> room = fetch room(id)
  |> guard room -> 404 "Room not found"

  stream {
    |> on event(presence) where(room_id == id) {
      -> { online: event.count, members: event.members }
    }
    |> on timeout(30s) {
      -> { online: 0, members: [] }
    }
  }
}
